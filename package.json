{
  "name": "gridline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gridline — US Data Center Infrastructure, Water/Power Footprint & Live Telemetry Atlas",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "cli": "bun run scripts/cli.ts",
    "ingest": "bun run scripts/ingest-us-census.ts",
    "deploy": "bun run build && wrangler deploy",
    "video:plates": "bun run video/capture-plates.ts",
    "video:audio": "bun run video/audio.ts",
    "video:render": "bun run video/render.ts"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "@types/bun": "latest",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright-core": "^1.65.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.16.1"
  }
}
